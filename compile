#!/usr/bin/bash
set -o pipefail

FILENAME=""
OPT_LEVEL="-O0"
OPT_LEVEL_SET=false
MODULE_OPTIONS=()
BLINK_BIN="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/blink"
LLVM_LL="new_output.ll"
LLVM_S="new_output.s"
LLVM_O="new_output.o"

parse_args() {
    local arg
    while [[ $# -gt 0 ]]; do
        arg="$1"
        shift
        case "$arg" in
            -module-root|-stdlib-root)
                if [[ $# -eq 0 || "$1" == -* ]]; then
                    printf "Error: %s requires a directory argument\n" "$arg" >&2
                    return 1
                fi
                MODULE_OPTIONS+=("$arg" "$1")
                shift
                ;;
            -O0|-O1|-O2|-O3)
                if [[ "$OPT_LEVEL_SET" == true ]]; then
                    printf "Error: only one optimization level may be specified\n" >&2
                    return 1
                fi
                OPT_LEVEL="$arg"
                OPT_LEVEL_SET=true
                ;;
            -O*)
                printf "Error: optimization level must be one of -O0, -O1, -O2, or -O3\n" >&2
                return 1
                ;;
            -*)
                printf "Error: unknown option: %s\n" "$arg" >&2
                return 1
                ;;
            *)
                if [[ -n "$FILENAME" ]]; then
                    printf "Error: multiple input files are not supported\n" >&2
                    return 1
                fi
                FILENAME="$arg"
                ;;
        esac
    done
}

sanitize_filename() {
    local fn; fn="$1"
    if [[ -z "$fn" ]]; then
        printf "Error: missing filename argument\n" >&2
        return 1
    fi
    # Arguments are always passed as quoted array elements, never evaluated as
    # shell text. Real paths may contain spaces, apostrophes, or '#' characters.
    if [[ ! "$fn" =~ \.bl$ ]]; then
        printf "Error: filename must end with .bl\n" >&2
        return 1
    fi
}

run_blink() {
    local fn; fn="$1"
    local optimization_level; optimization_level="$2"
    if ! "$BLINK_BIN" "$optimization_level" "${MODULE_OPTIONS[@]}" "$fn"; then
        printf "Error: blink failed\n" >&2
        return 1
    fi
    if [[ ! -s "$LLVM_LL" ]]; then
        printf "Error: %s not created or empty\n" "$LLVM_LL" >&2
        return 1
    fi
}

compile_ll_to_s() {
    if ! llc --relocation-model=pic "$LLVM_LL" -o "$LLVM_S"; then
        printf "Error: llc failed\n" >&2
        return 1
    fi
    if [[ ! -s "$LLVM_S" ]]; then
        printf "Error: %s not created or empty\n" "$LLVM_S" >&2
        return 1
    fi
}

compile_s_to_o() {
    if ! clang "$LLVM_S" -o "$LLVM_O" -lm; then
        printf "Error: clang failed\n" >&2
        return 1
    fi
    if [[ ! -s "$LLVM_O" ]]; then
        printf "Error: %s not created or empty\n" "$LLVM_O" >&2
        return 1
    fi
}

main() {
    if ! parse_args "$@"; then
        return 1
    fi

    if ! sanitize_filename "$FILENAME"; then
        return 1
    fi

    if ! run_blink "$FILENAME" "$OPT_LEVEL"; then
        return 1
    fi

    if ! compile_ll_to_s; then
        return 1
    fi

    if ! compile_s_to_o; then
        return 1
    fi

    printf "Build completed: %s\n" "$LLVM_O"
}

main "$@"
