@C fun puts(message: string);

class Point {
    let x: i32;
    let y: i32;

    inline fun midpoint(other: Point) => Point {
        return new Point {
            x = (this.x + other.x) / 2,
            y = (this.y + other.y) / 2
        };
    }
}

inline fun midpoint(left: i32, right: i32) => i32 {
    return (left + right) / 2;
}

fun main() => i32 {
    puts("Hello from Blink!");
    let first = new Point { x = 10, y = 10 };
    let second = new Point { x = 20, y = 20 };
    let middle = first.midpoint(second);
    let result = middle.x + midpoint(10, 0);
    free first, second, middle;
    return result;
}
