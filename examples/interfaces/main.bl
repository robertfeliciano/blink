import Value, read from contracts;

class First impl Value {
    fun value() => i32 { return 10; }
}

class Second impl Value {
    fun value() => i32 { return 20; }
}

fun choose(first: First, second: Second, useFirst: bool) => Value {
    let selected: Value = first;
    if not useFirst { selected = second; }
    return selected;
}

fun main() => i32 {
    let first = new First {};
    let second = new Second {};
    let left = read(choose(first, second, true));
    let right = read(choose(first, second, false));
    free first, second;
    if left == 10 and right == 20 { return 0; }
    return 1;
}
