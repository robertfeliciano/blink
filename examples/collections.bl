import List from std.collections.list;
import LinkedList from std.collections.linked_list;

fun first<T>(items: List<T>) => T {
    return items.get(0);
}

fun main() => i32 {
    let items = new LinkedList<i32> {};
    items.add(20);
    items.addFirst(1);
    items.addLast(22);
    let view: List<i32> = items;
    view.insert(-1, 21);
    let removed = items.removeFirst();
    let replaced = view.set(-2, 22);
    let result = first(items) + view.get(-1);
    if removed != 1 or replaced != 21 or view.size() != 3 { return 1; }
    view.clear();
    free items;
    return result;
}
