import answer from helper;
import geometry as shapes;
import println from std.io;
import count, advance, from state;
import state;

fun main() => i32 {
    let box: shapes.Box = new shapes.Box { value = answer() };
    println("Hello from Blink modules!");
    advance();
    let result = count;
    if box.read() != result or state.count != count { return 1; }
    free box;
    return result;
}
