fun add(left: i32, right: i32) => i32 {
    return left + right;
}

fun twice(value: i32) => i32 {
    return value * 2;
}

fun fibonacci(n: i32) => i32 {
    if n <= 1 { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fun main() => i32 {
    return add(twice(10), fibonacci(8)) + 1;
}
